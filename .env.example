# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Judges: the values for judging are sent in the submission form, not here.

# OpenAI key for banner visuals (image API)
OPENAI_API_KEY=

# Secret API key of the Lumen app (Adapty dashboard -> App settings -> General)
ADAPTY_SECRET_KEY=

# Lumen app id in Adapty
ADAPTY_APP_ID=

# Slack incoming webhook for Watch alerts (optional)
SLACK_WEBHOOK_URL=
